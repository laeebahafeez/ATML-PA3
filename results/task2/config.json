{
  "seed": 6304,
  "models": {
    "vision": "google/siglip-base-patch16-224",
    "language": "Qwen/Qwen3-0.6B",
    "language_revision": "c1899de289a04d12100db370d81485cdf75e47ca"
  },
  "connector": "Linear 768->1024, GELU, Linear 1024->1024; output scaled by calibration.json",
  "visual_tokens": {
    "main": 196,
    "optional": 49
  },
  "caps": {
    "question": 80,
    "caption": 64,
    "answer": 16
  },
  "prompts": {
    "caption": "Describe this image in one sentence.",
    "short_answer_suffix": "\nAnswer the question using a single word or number."
  },
  "micro_batch": 8,
  "grad_accum": 2,
  "effective_batch": 16,
  "optimizer": "AdamW betas (0.9, 0.999) eps 1e-8, weight decay 0.01 (not on biases); rebuilt per stage",
  "schedule": "per stage: 5% warmup, cosine decay to 10% of peak",
  "grad_clip": 1.0,
  "precision": "FP16 autocast, dynamic loss scaling, frozen FP16 backbone, FP32 trainable params",
  "gradient_checkpointing": true,
  "stages": [
    {
      "name": "caption",
      "updates": 2250,
      "lr_conn": 0.001,
      "lr_lora": null,
      "mix": null
    },
    {
      "name": "instruct",
      "updates": 1500,
      "lr_conn": 0.0001,
      "lr_lora": 2e-05,
      "mix": {
        "presence": 0.5,
        "counting": 0.25,
        "caption": 0.25
      }
    },
    {
      "name": "vqa",
      "updates": 750,
      "lr_conn": 5e-05,
      "lr_lora": 1e-05,
      "mix": {
        "vqa": 0.7,
        "presence": 0.1,
        "counting": 0.1,
        "caption": 0.1
      }
    }
  ],
  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "targets": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj"
    ]
  },
  "dev_every": 500,
  "checkpoint_every": 250,
  "final_eval": {
    "conditions": [
      "correct",
      "swap",
      "mismatched",
      "no_image"
    ],
    "decoding": "greedy",
    "max_new_tokens": 16,
    "batch_size": 8,
    "bootstrap_resamples": 4000
  },
  "data": {
    "caption_train_images": 6000,
    "captions_per_train_image": 3,
    "caption_dev": 96,
    "grounding_dev": {
      "presence": 12,
      "counting": 12
    },
    "grounding_test": {
      "presence": 32,
      "counting": 32
    },
    "vqa_train": {
      "yes/no": 640,
      "number": 256,
      "other": 640
    },
    "vqa_dev": {
      "yes/no": 12,
      "number": 8,
      "other": 12
    },
    "vqa_test": {
      "yes/no": 36,
      "number": 24,
      "other": 36
    },
    "vqa_min_agreement": 8,
    "presence_min_area": 0.02,
    "count_min_area": 0.01,
    "count_range": [
      1,
      4
    ]
  }
}